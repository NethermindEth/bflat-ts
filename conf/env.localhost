# The RCF ports of the two agents. Two runs on one host need ports of their
# own, so a free pair is picked for each run, below the ephemeral range of
# Linux (32768 and up), where outgoing connections do not take them.
# TE_RCF_PORT_BASE gives a fixed pair (base and base + 1) instead.
if [ -n "${TE_RCF_PORT_BASE}" ] ; then
    ts_rcf_ports="${TE_RCF_PORT_BASE} $((TE_RCF_PORT_BASE + 1))"
else
    ts_rcf_ports="$(python3 - <<'PY'
import random, socket
socks = []
while len(socks) < 2:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind(("0.0.0.0", random.randrange(20000, 32768)))
        socks.append(s)
    except OSError:
        s.close()
print(" ".join(str(s.getsockname()[1]) for s in socks))
PY
)" || ts_rcf_ports=""
    [ -n "${ts_rcf_ports}" ] || ts_rcf_ports="50012 50013"
fi
read -r ts_rcf_port1 ts_rcf_port2 <<< "${ts_rcf_ports}"

export TE_RCF_PORT=${ts_rcf_port1}

export TA_MAIN_HOST=localhost
export TA_MAIN_RCF_PORT=${ts_rcf_port1}

export TA_ZISK_HOST=localhost
export TA_ZISK_RCF_PORT=${ts_rcf_port2}
unset ts_rcf_ports ts_rcf_port1 ts_rcf_port2
