<package version="1.0">
    <description
    >bflat build tests - Runtime Heap Platform (rhp) stubs</description>

    <author mailto="maksim.menshikov@nethermind.io" />

    <session track_conf="silent">
        <run-template name="bflat_build">
            <arg name="ta">
                <value>agt_main</value>
            </arg>
            <arg name="bflat_image">
                <value>-</value>
            </arg>
            <arg name="bflat_arch">
                <value>riscv64</value>
            </arg>
            <!-- The four targets iterate in lockstep with bflat_extlib below:
                 each zkVM takes its platform and bindings from its own package
                 (zisk_sim from the ZisK package); without it bflat does not know
                 the target. -->
            <arg name="bflat_libc" list="target">
                <value>zisk</value>
                <value>zisk_sim</value>
                <value>sp1</value>
                <value>openvm</value>
            </arg>
            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>TRUE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="run">
                <value>TRUE</value>
            </arg>
            <arg name="run_timeout_ms">
                <value>600000</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.3.2-alpha.151/nethermind.ziskos.runtime.1.3.2-alpha.151.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.3.2-alpha.151/nethermind.ziskos.runtime.1.3.2-alpha.151.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.60/nethermind.sp1.runtime.6.9.0.60.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.61/nethermind.openvm.runtime.2.1.0.61.nupkg</value>
            </arg>
            <arg name="qemu_path">
                <value>/usr/bin/qemu-riscv64-static</value>
            </arg>
            <arg name="zisk_image">
                <value>nethermindeth/zisk:latest</value>
            </arg>
            <!-- Harness images and the OpenVM extension set: "-" takes the
                 defaults pinned in tsapi_zkvm.h and the config shipped in the
                 OpenVM image. -->
            <arg name="zkvm_image">
                <value>-</value>
            </arg>
            <arg name="openvm_config">
                <value>-</value>
            </arg>
            <arg name="expected_stdout">
                <value>-</value>
            </arg>
        </run-template>

        <run name="objects" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>objects.cs</value>
            </arg>
        </run>

        <run name="arrays" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>arrays.cs</value>
            </arg>
        </run>

        <run name="strings" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>strings.cs</value>
            </arg>
        </run>

        <run name="type_cast" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>type_cast.cs</value>
            </arg>
        </run>

        <run name="number_fmt" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>number_fmt.cs</value>
            </arg>
        </run>
    </session>
</package>
