<package version="1.0">
    <description
    >bflat run-performance tests - startup steps analysis under ziskemu</description>

    <author mailto="maksim.menshikov@nethermind.io" />

    <session track_conf="silent">
        <run>
            <script name="run_perf" />
            <arg name="ta">
                <value>agt_main</value>
            </arg>
            <arg name="cs_file">
                <value>startup.cs</value>
            </arg>
            <arg name="bflat_image">
                <value>-</value>
            </arg>
            <arg name="bflat_arch">
                <value>riscv64</value>
            </arg>
            <!-- ZisK only. This test is not "run the guest and time it": it
                 runs ziskemu with tracing and turns the trace into a per-symbol
                 instruction profile, which no other runner here produces. SP1
                 and OpenVM report their own cycle counts on every run. -->
            <arg name="bflat_libc">
                <value>zisk</value>
            </arg>
            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>FALSE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="bflat_extlib">
                <value>https://apiint.nugettest.org/v3-flatcontainer/nethermind.ziskos.runtime/1.0.0-preview.9/nethermind.ziskos.runtime.1.0.0-preview.9.nupkg</value>
            </arg>
            <arg name="zisk_image">
                <value>nethermindeth/zisk:latest</value>
            </arg>
            <!-- Harness images and the OpenVM extension set: "-" takes the
                 defaults pinned in tsapi_zkvm.h and the config shipped in the
                 OpenVM image. -->
            <arg name="zkvm_image">
                <value>-</value>
            </arg>
            <arg name="openvm_config">
                <value>-</value>
            </arg>
            <arg name="run_timeout_ms">
                <value>1800000</value>
            </arg>
            <!-- Threshold: 0 = disabled. Baseline: ~4 790 000 steps (+25% headroom) -->
            <arg name="max_startup_steps">
                <value>6000000</value>
            </arg>
            <!-- Threshold: 0 = disabled. Baseline: ~152 s, limit 5 min -->
            <arg name="max_run_time_ms">
                <value>300000</value>
            </arg>
        </run>
    </session>
</package>
