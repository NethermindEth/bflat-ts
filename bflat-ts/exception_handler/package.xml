<package version="1.0">
    <description>bflat build tests - exception handling, both policies</description>

    <author mailto="maksim.menshikov@nethermind.io" />

    <session track_conf="silent">
        <run-template name="bflat_build">
            <arg name="ta">
                <value>agt_main</value>
            </arg>
            <arg name="bflat_image">
                <value>-</value>
            </arg>
            <!-- In lockstep with bflat_libc: the Airbender target is riscv32,
                 which only the riscv32 bflat image builds. -->
            <arg name="bflat_arch" list="target">
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv32</value>
            </arg>
            <!-- The targets iterate in lockstep with bflat_extlib below:
                 each zkVM takes its platform and bindings from its own package
                 (zisk_sim from the ZisK package); without it bflat does not know
                 the target. -->
            <arg name="bflat_libc" list="target">
                <value>zisk</value>
                <value>zisk_sim</value>
                <value>sp1</value>
                <value>openvm</value>
                <value>airbender</value>
            </arg>
            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>TRUE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="run">
                <value>TRUE</value>
            </arg>
            <arg name="run_timeout_ms">
                <value>600000</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.157/nethermind.ziskos.runtime.1.4.0-alpha.157.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.157/nethermind.ziskos.runtime.1.4.0-alpha.157.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.73/nethermind.openvm.runtime.2.1.0.73.nupkg</value>
                <value>https://github.com/NethermindEth/bflat-airbender/releases/download/v1.0.9/libairbender-riscv32.tar.gz#libairbender.bflat.manifest</value>
            </arg>
            <arg name="qemu_path">
                <value>/usr/bin/qemu-riscv64-static</value>
            </arg>
            <arg name="zisk_image">
                <value>nethermindeth/zisk:1.4.0-alpha@sha256:76bc753857e1807b724979a119ba919af0d857b3ea5deda982fd84b1be2cb930</value>
            </arg>
            <!-- Harness images and the OpenVM extension set: "-" takes the
                 defaults pinned in tsapi_zkvm.h and the config shipped in the
                 OpenVM image. -->
            <arg name="zkvm_image">
                <value>-</value>
            </arg>
            <arg name="openvm_config">
                <value>-</value>
            </arg>
            <arg name="expected_stdout">
                <value>-</value>
            </arg>
            <arg name="remove_eh">
                <value>FALSE</value>
            </arg>
            <arg name="expected_status">
                <value>0</value>
            </arg>
        </run-template>

        <!--
            Exception handling is a build-time policy and the two settings are
            different mechanisms, so each is tested where it applies.

            Default: the image keeps its unwind tables and a throw is
            dispatched in two passes, so managed code can catch it.
        -->
        <run name="eh_caught" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>eh_caught.cs</value>
            </arg>
            <!-- In lockstep with bflat_libc: Console output is swallowed on
                 ZisK, whose console binding belongs to ziskos rather than to
                 the runtime's write path, so there the guest is only required
                 to reach the handler and exit cleanly. -->
            <arg name="expected_stdout" list="target">
                <value>-</value>
                <value>[caught] System.InvalidOperationException: boom from managed code</value>
                <value>[caught] System.InvalidOperationException: boom from managed code</value>
                <value>[caught] System.InvalidOperationException: boom from managed code</value>
                <value>[caught] System.InvalidOperationException: boom from managed code</value>
            </arg>
        </run>

        <!--
            The rest of the dispatch: filters (and one that throws), rethrow,
            a throw inside a catch or a finally, a deep stack of finallys,
            interface calls on boxed generic structs (unboxing stubs), generic
            virtual methods, delegates, iterators, a failing static constructor
            and the runtime's throw helpers. The guest returns the number of
            failed cases, so ZisK, which swallows the output, still checks it.
        -->
        <run name="eh_more" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>eh_more.cs</value>
            </arg>
            <arg name="expected_stdout" list="target">
                <value>-</value>
                <value>ALL PASS</value>
                <value>ALL PASS</value>
                <value>ALL PASS</value>
                <value>ALL PASS</value>
            </arg>
        </run>

        <!--
            Exceptions through large frames. A frame over 2040 bytes is
            allocated in two steps, and a method without a frame pointer
            keeps its CFA on SP, so its unwind info has to describe both;
            with the second one missing the unwinder reads a wrong return
            address and the runtime fails fast (exit code 134). The frames
            step over the limit in 8-byte steps and go up to 16 KiB, with
            few and with all callee-saved registers in use, with stack
            arguments, under a finally, a filter and a rethrow, and the
            throw comes from below the frame, from the frame itself and from
            the runtime's helpers. The guest returns the number of failed
            cases.

            Before the run the unwind info of the binary is checked against
            its code (eh_frame_check.py). The program has some 240 such
            frames on either architecture; fewer than 100 means they are no
            longer compiled without a frame pointer, and the run would pass
            without testing anything.

            Not on zisk_sim: its stack is 64 KB, less than a few frames of
            the largest sizes take.
        -->
        <run name="eh_large_frame" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>eh_large_frame.cs</value>
            </arg>
            <arg name="unwind_split_min">
                <value>100</value>
            </arg>
            <arg name="bflat_arch" list="target">
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv32</value>
            </arg>
            <arg name="bflat_libc" list="target">
                <value>zisk</value>
                <value>sp1</value>
                <value>openvm</value>
                <value>airbender</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.157/nethermind.ziskos.runtime.1.4.0-alpha.157.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.73/nethermind.openvm.runtime.2.1.0.73.nupkg</value>
                <value>https://github.com/NethermindEth/bflat-airbender/releases/download/v1.0.9/libairbender-riscv32.tar.gz#libairbender.bflat.manifest</value>
            </arg>
            <arg name="expected_stdout" list="target">
                <value>-</value>
                <value>ALL PASS</value>
                <value>ALL PASS</value>
                <value>ALL PASS</value>
            </arg>
        </run>

        <!--
            The same program with a frame pointer in every method: the CFA
            is on FP and does not depend on how the frame is allocated. It
            is the control for the run above, and checks the frame-pointer
            prolog and epilog of the same frame sizes.
        -->
        <run name="eh_large_frame_framed" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>eh_large_frame.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>RiscV64FramelessFrames=0</value>
            </arg>
            <arg name="unwind_split_min">
                <value>0</value>
            </arg>
            <arg name="bflat_arch" list="target">
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv32</value>
            </arg>
            <arg name="bflat_libc" list="target">
                <value>zisk</value>
                <value>sp1</value>
                <value>openvm</value>
                <value>airbender</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.157/nethermind.ziskos.runtime.1.4.0-alpha.157.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.73/nethermind.openvm.runtime.2.1.0.73.nupkg</value>
                <value>https://github.com/NethermindEth/bflat-airbender/releases/download/v1.0.9/libairbender-riscv32.tar.gz#libairbender.bflat.manifest</value>
            </arg>
            <arg name="expected_stdout" list="target">
                <value>-</value>
                <value>ALL PASS</value>
                <value>ALL PASS</value>
                <value>ALL PASS</value>
            </arg>
        </run>

        <!--
            With the tables removed, RhpThrowEx is diverted to the guest's own
            ZkvmThrow, which receives the live exception object.
        -->
        <run name="exhandler" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>exhandler.cs</value>
            </arg>
            <arg name="remove_eh">
                <value>TRUE</value>
            </arg>
            <arg name="expected_stdout" list="target">
                <value>-</value>
                <value>[ZkvmThrow] System.InvalidOperationException: boom from managed code</value>
                <value>[ZkvmThrow] System.InvalidOperationException: boom from managed code</value>
                <value>[ZkvmThrow] System.InvalidOperationException: boom from managed code</value>
                <value>[ZkvmThrow] System.InvalidOperationException: boom from managed code</value>
            </arg>
        </run>

        <!--
            And what each policy does with an exception nobody handles. Only on
            SP1: its harness prints the guest's own status, while ziskemu
            reports its own and OpenVM's TERMINATE takes an immediate, so every
            non-zero status reaches that host as 1. The harness itself exits 1
            for any failed guest, which is why the status expected here is 1 in
            both cases and the distinction is read off its report.
        -->
        <run name="eh_uncaught_failfast" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>eh_uncaught.cs</value>
            </arg>
            <arg name="bflat_arch">
                <value>riscv64</value>
            </arg>
            <arg name="bflat_libc">
                <value>sp1</value>
            </arg>
            <arg name="bflat_extlib">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
            </arg>
            <arg name="expected_status">
                <value>1</value>
            </arg>
            <!-- abort(): 128 + SIGABRT, the runtime's fail-fast -->
            <arg name="expected_stdout">
                <value>exit_code 134</value>
            </arg>
        </run>

        <run name="eh_uncaught_zkvmthrow" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>eh_uncaught.cs</value>
            </arg>
            <arg name="bflat_arch">
                <value>riscv64</value>
            </arg>
            <arg name="bflat_libc">
                <value>sp1</value>
            </arg>
            <arg name="bflat_extlib">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
            </arg>
            <arg name="remove_eh">
                <value>TRUE</value>
            </arg>
            <arg name="expected_status">
                <value>1</value>
            </arg>
            <!-- __wrap_RhpThrowEx with no ZkvmThrow bound: exit(1) -->
            <arg name="expected_stdout">
                <value>exit_code 1</value>
            </arg>
        </run>

        <!-- unaligned reads of the unwind tables (patch 17) -->
        <run name="unwind_table_reads" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>unwind_table_reads.cs</value>
            </arg>
        </run>
    </session>
</package>
