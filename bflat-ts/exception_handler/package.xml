            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>TRUE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="run">
                <value>TRUE</value>
            </arg>
            <arg name="run_timeout_ms">
                <value>600000</value>
            </arg>
            <arg name="bflat_extlib">
                <value
                >https://apiint.nugettest.org/v3-flatcontainer/nethermind.ziskos.runtime/1.0.0-preview.5/nethermind.ziskos.runtime.1.0.0-preview.5.nupkg</value>
            </arg>
            <arg name="qemu_path">
                <value>/usr/bin/qemu-riscv64-static</value>
            </arg>
            <arg name="zisk_image">
                <value>-</value>
            </arg>
            <arg name="expected_stdout">
                <value>-</value>
            </arg>
            <arg name="expected_status">
                <value>0</value>
            </arg>
        </run-template>

