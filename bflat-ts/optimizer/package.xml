<package version="1.0">
    <description>bflat build tests - Optimizer and register allocation</description>

    <author mailto="maksim.menshikov@nethermind.io" />

    <session track_conf="silent">
        <run-template name="bflat_build">
            <arg name="ta">
                <value>agt_main</value>
            </arg>
            <arg name="bflat_image">
                <value>-</value>
            </arg>
            <!-- In lockstep with bflat_libc: the Airbender target is riscv32,
                 which only the riscv32 bflat image builds. -->
            <arg name="bflat_arch" list="target">
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv32</value>
            </arg>
            <!-- The targets iterate in lockstep with bflat_extlib below:
                 each zkVM takes its platform and bindings from its own package
                 (zisk_sim from the ZisK package); without it bflat does not know
                 the target. -->
            <arg name="bflat_libc" list="target">
                <value>zisk</value>
                <value>zisk_sim</value>
                <value>sp1</value>
                <value>openvm</value>
                <value>airbender</value>
            </arg>
            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>TRUE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="run">
                <value>TRUE</value>
            </arg>
            <arg name="run_timeout_ms">
                <value>600000</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.156/nethermind.ziskos.runtime.1.4.0-alpha.156.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.156/nethermind.ziskos.runtime.1.4.0-alpha.156.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.73/nethermind.openvm.runtime.2.1.0.73.nupkg</value>
                <value>https://github.com/NethermindEth/bflat-airbender/releases/download/v1.0.5/libairbender-riscv32.tar.gz#libairbender.bflat.manifest</value>
            </arg>
            <arg name="qemu_path">
                <value>/usr/bin/qemu-riscv64-static</value>
            </arg>
            <arg name="zisk_image">
                <value>nethermindeth/zisk:1.4.0-alpha@sha256:76bc753857e1807b724979a119ba919af0d857b3ea5deda982fd84b1be2cb930</value>
            </arg>
            <!-- Harness images and the OpenVM extension set: "-" takes the
                 defaults pinned in tsapi_zkvm.h and the config shipped in the
                 OpenVM image. -->
            <arg name="zkvm_image">
                <value>-</value>
            </arg>
            <arg name="openvm_config">
                <value>-</value>
            </arg>
            <arg name="expected_stdout">
                <value>-</value>
            </arg>
        </run-template>

        <!-- caller- and callee-saved register preference (perf-55) -->
        <run name="register_classes" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>register_classes.cs</value>
            </arg>
        </run>

        <run name="register_classes_default_order" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>register_classes.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitRiscV64LsraCallerCalleeFirst=0</value>
            </arg>
        </run>

        <!-- switch tables in the data section (perf-37) -->
        <run name="jump_tables" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>jump_tables.cs</value>
            </arg>
        </run>

        <!-- spills that keep the register (perf-63) -->
        <run name="spill_reload" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>spill_reload.cs</value>
            </arg>
        </run>

        <run name="spill_reload_plain_spill" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>spill_reload.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkSpillKeepReg=0</value>
            </arg>
        </run>

        <!-- null checks and probes into the zero register (perf-46, perf-70) -->
        <run name="null_check_probes" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>null_check_probes.cs</value>
            </arg>
        </run>

        <!-- the inliner with the release knobs (perf-32, perf-57) -->
        <run name="inlining_knobs" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>inlining_knobs.cs</value>
            </arg>
        </run>

        <run name="inlining_knobs_multiplier" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>inlining_knobs.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitInlineAdditionalMultiplier=3</value>
            </arg>
        </run>

        <!-- block weights synthesized without a profile (perf-62) -->
        <run name="synthesized_block_weights" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>synthesized_block_weights.cs</value>
            </arg>
        </run>

        <run name="synthesized_block_weights_synthesized" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>synthesized_block_weights.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkSynthesizeCounts=1</value>
            </arg>
        </run>

        <!-- the zkVM code generation knobs (riscv32 06, 07) -->
        <run name="rv32_zk_knobs" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>rv32_zk_knobs.cs</value>
            </arg>
        </run>
    </session>
</package>
