<package version="1.0">
    <description
    >bflat build tests - heap allocator correctness under grow and large allocations</description>

    <author mailto="maksim.menshikov@nethermind.io" />

    <session track_conf="silent">
        <run-template name="bflat_build">
            <arg name="ta">
                <value>agt_main</value>
            </arg>
            <arg name="bflat_image">
                <value>-</value>
            </arg>
            <!-- In lockstep with bflat_libc: the Airbender target is riscv32,
                 which only the riscv32 bflat image builds. -->
            <arg name="bflat_arch" list="target">
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv32</value>
            </arg>
            <!-- The targets iterate in lockstep with bflat_extlib below:
                 each zkVM takes its platform and bindings from its own package
                 (zisk_sim from the ZisK package); without it bflat does not know
                 the target. -->
            <arg name="bflat_libc" list="target">
                <value>zisk</value>
                <value>zisk_sim</value>
                <value>sp1</value>
                <value>openvm</value>
                <value>airbender</value>
            </arg>
            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>TRUE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="run">
                <value>TRUE</value>
            </arg>
            <arg name="run_timeout_ms">
                <value>600000</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.156/nethermind.ziskos.runtime.1.4.0-alpha.156.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.156/nethermind.ziskos.runtime.1.4.0-alpha.156.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.73/nethermind.openvm.runtime.2.1.0.73.nupkg</value>
                <value>https://github.com/NethermindEth/bflat-airbender/releases/download/v1.0.5/libairbender-riscv32.tar.gz#libairbender.bflat.manifest</value>
            </arg>
            <arg name="qemu_path">
                <value>/usr/bin/qemu-riscv64-static</value>
            </arg>
            <arg name="zisk_image">
                <value>nethermindeth/zisk:1.4.0-alpha@sha256:76bc753857e1807b724979a119ba919af0d857b3ea5deda982fd84b1be2cb930</value>
            </arg>
            <!-- Harness images and the OpenVM extension set: "-" takes the
                 defaults pinned in tsapi_zkvm.h and the config shipped in the
                 OpenVM image. -->
            <arg name="zkvm_image">
                <value>-</value>
            </arg>
            <arg name="openvm_config">
                <value>-</value>
            </arg>
            <arg name="expected_stdout">
                <value>-</value>
            </arg>
        </run-template>

        <run name="list_growth" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>list_growth.cs</value>
            </arg>
        </run>

        <run name="stringbuilder" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>stringbuilder.cs</value>
            </arg>
        </run>

        <run name="large_array" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>large_array.cs</value>
            </arg>
        </run>

        <!-- objects allocated on the stack in loops (perf-25) -->
        <run name="stack_objects_in_loops" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>stack_objects_in_loops.cs</value>
            </arg>
        </run>

        <run name="stack_objects_in_loops_heap" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>stack_objects_in_loops.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitObjectStackAllocation=0</value>
            </arg>
        </run>

        <!-- GC locals that are not zeroed in the prolog (perf-83, perf-85) -->
        <run name="uninit_gc_locals" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>uninit_gc_locals.cs</value>
            </arg>
        </run>

        <run name="uninit_gc_locals_must_init" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>uninit_gc_locals.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkNoGcMustInit=0</value>
            </arg>
        </run>

        <!-- fixed statements without pinning (perf-61) -->
        <run name="fixed_pinned" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>fixed_pinned.cs</value>
            </arg>
        </run>

        <run name="fixed_pinned_pinned" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>fixed_pinned.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkNoPinning=0</value>
            </arg>
        </run>

        <!-- memmove of every length, offset and overlap (perf-29, perf-54, perf-58, perf-66) -->
        <run name="memmove_lengths" template="bflat_build">
            <script name="build" />
            <!-- The 64-bit targets only. -->
            <arg name="bflat_arch" list="target">
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
                <value>riscv64</value>
            </arg>
            <arg name="bflat_libc" list="target">
                <value>zisk</value>
                <value>zisk_sim</value>
                <value>sp1</value>
                <value>openvm</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.156/nethermind.ziskos.runtime.1.4.0-alpha.156.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.4.0-alpha.156/nethermind.ziskos.runtime.1.4.0-alpha.156.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.87/nethermind.sp1.runtime.6.9.0.87.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.73/nethermind.openvm.runtime.2.1.0.73.nupkg</value>
            </arg>
            <arg name="cs_file">
                <value>memmove_lengths.cs</value>
            </arg>
        </run>

        <!-- inline comparison of byte ranges (perf-30) -->
        <run name="sequence_equal" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>sequence_equal.cs</value>
            </arg>
        </run>

        <run name="sequence_equal_call" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>sequence_equal.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitRiscV64DmaCompare=0</value>
            </arg>
        </run>

        <!-- unrolled block copies and fills (perf-44, perf-50a, perf-65) -->
        <run name="block_copies" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>block_copies.cs</value>
            </arg>
        </run>

        <run name="block_copies_no_csr" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>block_copies.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkMemcpyCsr=0</value>
            </arg>
        </run>

        <!-- moves of a constant size between overlapping ranges (perf-50b) -->
        <run name="const_size_moves" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>const_size_moves.cs</value>
            </arg>
        </run>

        <!-- zeroing of the frame in the prolog (perf-64) -->
        <run name="frame_zero_init" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>frame_zero_init.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkInitLocallocOnly=0</value>
            </arg>
        </run>

        <run name="frame_zero_init_no_csr" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>frame_zero_init.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkInitLocallocOnly=0;JitZkMemsetCsr=0</value>
            </arg>
        </run>

        <!-- INT fields loaded as whole words (perf-78) -->
        <run name="object_word_loads" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>object_word_loads.cs</value>
            </arg>
        </run>

        <run name="object_word_loads_no_bump" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>object_word_loads.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkBumpAddr=0</value>
            </arg>
        </run>

        <!-- the array length read and written as a word (perf-73, perf-79) -->
        <run name="array_length_word" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>array_length_word.cs</value>
            </arg>
        </run>

        <run name="array_length_word_no_bump" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>array_length_word.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkBumpAddr=0</value>
            </arg>
        </run>

        <!-- stores of references without a write barrier (perf-24) -->
        <run name="gc_ref_stores" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>gc_ref_stores.cs</value>
            </arg>
        </run>

        <!-- objects allocated inline (perf-26) -->
        <run name="inline_object_alloc" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>inline_object_alloc.cs</value>
            </arg>
        </run>

        <run name="inline_object_alloc_helper" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>inline_object_alloc.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkBumpAddr=0</value>
            </arg>
        </run>

        <!-- arrays allocated inline (patch 22, perf-49, perf-52) -->
        <run name="inline_array_alloc" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>inline_array_alloc.cs</value>
            </arg>
        </run>

        <run name="inline_array_alloc_helper" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>inline_array_alloc.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkBumpAddr=0</value>
            </arg>
        </run>

        <!-- array lengths that cannot be allocated (perf-26, perf-49, perf-52) -->
        <run name="array_length_checks" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>array_length_checks.cs</value>
            </arg>
        </run>

        <run name="array_length_checks_helper" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>array_length_checks.cs</value>
            </arg>
            <arg name="bflat_codegenopt">
                <value>JitZkBumpAddr=0</value>
            </arg>
            <!-- With the helper an array that does not fit is an exception. -->
            <arg name="bflat_define">
                <value>HEAP_EXHAUSTION</value>
            </arg>
        </run>

        <!-- arrays, block stores and enums (riscv32 02, 03, 06) -->
        <run name="rv32_arrays_blocks" template="bflat_build">
            <script name="build" />
            <arg name="cs_file">
                <value>rv32_arrays_blocks.cs</value>
            </arg>
        </run>
    </session>
</package>