<package version="1.0">
    <description
    >bflat build-performance tests - compile time measurement</description>

    <author mailto="maksim.menshikov@nethermind.io" />

    <session track_conf="silent">
        <run>
            <script name="build_perf" />
            <arg name="ta">
                <value>agt_main</value>
            </arg>
            <arg name="cs_file">
                <value>big_refs.cs</value>
            </arg>
            <arg name="bflat_image">
                <value>-</value>
            </arg>
            <arg name="bflat_arch">
                <value>riscv64</value>
            </arg>
            <!-- The four targets iterate in lockstep with bflat_extlib below:
                 each zkVM takes its bindings from its own package, and without
                 them the guest has no console and no accelerators. -->
            <arg name="bflat_libc" list="target">
                <value>zisk_sim</value>
                <value>zisk</value>
                <value>sp1</value>
                <value>openvm</value>
            </arg>
            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>FALSE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>-</value>
                <value>https://apiint.nugettest.org/v3-flatcontainer/nethermind.ziskos.runtime/1.0.0-preview.5/nethermind.ziskos.runtime.1.0.0-preview.5.nupkg</value>
                <value>https://apiint.nugettest.org/v3-flatcontainer/nethermind.sp1.runtime/1.0.0-preview.1/nethermind.sp1.runtime.1.0.0-preview.1.nupkg</value>
                <value>https://apiint.nugettest.org/v3-flatcontainer/nethermind.openvm.runtime/1.0.0-preview.1/nethermind.openvm.runtime.1.0.0-preview.1.nupkg</value>
            </arg>
            <!-- Threshold: 0 = disabled. Limit 5 min for big_refs.cs compilation -->
            <arg name="max_build_time_ms">
                <value>300000</value>
            </arg>
        </run>
    </session>
</package>
