<package version="1.0">
    <description
    >bflat build-performance tests - compile time measurement</description>

    <author mailto="maksim.menshikov@nethermind.io" />

    <session track_conf="silent">
        <run>
            <script name="build_perf" />
            <arg name="ta">
                <value>agt_main</value>
            </arg>
            <arg name="cs_file">
                <value>big_refs.cs</value>
            </arg>
            <arg name="bflat_image">
                <value>-</value>
            </arg>
            <arg name="bflat_arch">
                <value>riscv64</value>
            </arg>
            <!-- The four targets iterate in lockstep with bflat_extlib below:
                 each zkVM takes its platform and bindings from its own package
                 (zisk_sim from the ZisK package); without it bflat does not know
                 the target. -->
            <arg name="bflat_libc" list="target">
                <value>zisk_sim</value>
                <value>zisk</value>
                <value>sp1</value>
                <value>openvm</value>
            </arg>
            <arg name="bflat_stdlib">
                <value>dotnet</value>
            </arg>
            <arg name="verbose">
                <value>FALSE</value>
            </arg>
            <arg name="no_globalization">
                <value>TRUE</value>
            </arg>
            <arg name="no_stacktrace_data">
                <value>TRUE</value>
            </arg>
            <arg name="no_pthread">
                <value>TRUE</value>
            </arg>
            <arg name="no_pie">
                <value>TRUE</value>
            </arg>
            <arg name="bflat_extlib" list="target">
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.3.2-alpha.151/nethermind.ziskos.runtime.1.3.2-alpha.151.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.ziskos.runtime/1.3.2-alpha.151/nethermind.ziskos.runtime.1.3.2-alpha.151.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.sp1.runtime/6.9.0.60/nethermind.sp1.runtime.6.9.0.60.nupkg</value>
                <value>https://api.nuget.org/v3-flatcontainer/nethermind.openvm.runtime/2.1.0.61/nethermind.openvm.runtime.2.1.0.61.nupkg</value>
            </arg>
            <!-- Threshold: 0 = disabled. Limit 5 min for big_refs.cs compilation -->
            <arg name="max_build_time_ms">
                <value>300000</value>
            </arg>
        </run>
    </session>
</package>
